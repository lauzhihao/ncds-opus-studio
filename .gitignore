__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
node_modules
state/
video-jobs/
web/dist/
web/dist.tmp/
web/dist.old/
web/node_modules/.deploy_lock_hash
web/*.tsbuildinfo
# tsc -b 增量编译会 emit vite.config 的 .d.ts/.js 副产物（即便 tsconfig.noEmit）；忽略
web/vite.config.d.ts
web/vite.config.js
.project_map
.env
*.log
.DS_Store
.gstack/

# dbskill 等第三方 skill：项目级安装，本地可用，不并入本仓库（真源在 .agents/，skills/ 与 .claude/skills/ 为软链）
/.agents/
/.claude/skills/
/skills-lock.json
/skills/dbs*

# 本地音源库（伯牙素材）：音频文件由库主维护、版权自负，不入库；只留结构 + README + library.json
/assets/audio_lib/bgm/*
/assets/audio_lib/sfx/*
!/assets/audio_lib/bgm/.gitkeep
!/assets/audio_lib/sfx/.gitkeep

# 本地剪影库（吴道子素材）：图片由库主维护、版权自负，不入库；只留结构 + README + library.json
/assets/figure_lib/figures/*
!/assets/figure_lib/figures/.gitkeep

# 成片预览字体包：体积大且来源于 ncds-materials，本地/服务器按需 scp，不入库
/packages/core/src/ncds_opus_core/templates/final_preview/.final-preview-assets/fonts/

# 测试/工具产物
.coverage
uv.lock
/outputs/
/tmp/

# OAuth / Apple keys (never commit)
secrets/
