# DashScope (HappyHorse 视频生成 + CosyVoice TTS + Tingwu ASR)
DASHSCOPE_API_KEY=

# gpt-image-2 网关（图生图、文生图）
GPT_IMAGE2_API_KEY=
GPT_IMAGE2_BASE_URL=https://codeproxy.dev/v1

# 图片公网上传（/vid 需要参考图公网 URL 才能传给 DashScope）
NOF_IMAGE_PUBLIC_BASE_URL=https://vooice.tech/feishu-images
NOF_IMAGE_UPLOAD_SSH_TARGET=root@gpt.vooice.tech
NOF_IMAGE_UPLOAD_REMOTE_DIR=/var/www/vooice.tech/feishu-images

# /asr /rw Node runner
OPENCLAW_PYTHON=/opt/homebrew/bin/python3

# RW 4 模型并行里的 deepseek 槽（缺省则 deepseek 标"模型不可用"）
DEEPSEEK_API_KEY=

# AGY/Gemini CLI 槽；设为 0 可让 worker 跳过 agy，避免触发 Google 登录
NOF_AGY=1

# TikHub(沈括采集:抖音视频/作者作品/评论,https://tikhub.io)
TIKHUB_API_TOKEN=

# DouK/TikTokDownloader sidecar(沈括下载:DouK -> yt-dlp -> TikHub)
# nof-worker 默认会尝试从 ../TikTokDownloader 启动 download_server.py，并写入 NOF_DOUK_ENDPOINT。
# 分机器部署时直接配置远端 endpoint；不希望 worker 拉起本机 sidecar 时设 NOF_DOUK_AUTOSTART=0。
# NOF_DOUK_ENDPOINT=http://127.0.0.1:5556
# NOF_DOUK_REPO=../TikTokDownloader
# NOF_DOUK_PORT=5556
# NOF_DOUK_TOKEN=
# NOF_DOUK_TIKTOK_PROXY=http://127.0.0.1:10808
# NOF_DOUK_AUTOSTART=1

# Worker 拆分 S3：任务队列走 Redis（nof-worker 消费 / 8810 入队）。queue.py 已内置同默认值，本地可不设
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth（/studio 登录）。三件套齐全才启用鉴权；缺任一项则与历史一致全站开放。
# Google Cloud Console → OAuth client → Authorized redirect URI（须含 https://）:
#   {PUBLIC_BASE_URL}/api/auth/google/callback
# 例: https://opus.vooice.tech/api/auth/google/callback
# 本地: http://127.0.0.1:8810/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_SESSION_SECRET=  # 任意长随机串，用于 state cookie HMAC
# PUBLIC_BASE_URL=https://opus.vooice.tech
# AUTH_ALLOWED_EMAILS=you@gmail.com,other@example.com
# AUTH_ALLOWED_DOMAIN=  # 可选，与 EMAILS 二选一；都空则任意已验证 Google 邮箱可登录
# NOF_AUTH_DB=  # 默认 state/auth.db
